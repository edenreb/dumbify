{
  "name": "dumbify",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:firefox": "vite build --mode firefox",
    "build:edge": "vite build --mode edge",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test 'tests/*.test.ts'",
    "test:e2e": "node --test 'tests/e2e/*.test.mjs'",
    "screenshots": "node tests/e2e/screenshots.mjs",
    "site": "vite build --config src/demo/vite.config.ts",
    "site:privacy": "node docs/build-privacy.mjs",
    "site:shots": "node tests/e2e/site-shots.mjs",
    "store:shots": "node tests/e2e/store-shots.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@types/chrome": "^0.2.2",
    "@types/node": "^22.20.4",
    "playwright": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
